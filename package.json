{
  "name": "@luminet/design-library",
  "version": "0.1.0",
  "workspaces": [
    "playground"
  ],
  "description": "Luminet Design Library — React components with Tailwind v4 tokens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pravin-pranesh/luminet-design-library.git"
  },
  "bugs": {
    "url": "https://github.com/pravin-pranesh/luminet-design-library/issues"
  },
  "homepage": "https://github.com/pravin-pranesh/luminet-design-library#readme",
  "keywords": [
    "luminet",
    "design-system",
    "react",
    "components",
    "tailwindcss",
    "tailwind-v4",
    "ui",
    "cva"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "theme.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "dev": "npm run dev --prefix playground",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
